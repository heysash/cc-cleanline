#!/usr/bin/env bash
# ====================================================================
# CC CleanLine — local configuration override example
# ====================================================================
# Copy this file to cc-cleanline.config.local and uncomment the lines
# you want to change. Anything left commented out uses the defaults
# from cc-cleanline.config.sh.
#
# The .local file is git-ignored, so personal settings stay local.
# ====================================================================

# ---- Display toggles ------------------------------------------------

# Show the full absolute path instead of just ./dirname.
# SHOW_FULL_PATH=true

# Hide the absolute token count (only show the percentage).
# SHOW_TOKEN_ABSOLUTE=false

# Hide the context-window percentage (only show the absolute count).
# SHOW_TOKEN_PERCENT_TOTAL=false

# Hide the 4-star effort meter (☆☆☆☆ … ★★★★) next to the model.
# SHOW_EFFORT_BADGE=false

# Hide the ¹ᴹ badge for [1m] context-window variants.
# SHOW_1M_BADGE=false

# Hide the ⚠legacy hint for legacy model IDs.
# SHOW_LEGACY_MARKER=false

# Suppress line 4 (worktree info) even when a worktree is active.
# SHOW_WORKTREE_LINE=false

# Suppress line 5 (output style / vim / PR) even when fields are set.
# SHOW_EXTRAS_LINE=false

# Append the Claude Code version (e.g. "v2.1.150") to line 5.
# SHOW_VERSION=true

# ---- Colors ---------------------------------------------------------

# Switch the active-status colour from green to blue.
# COLOR_ACTIVE_STATUS='\033[94m'

# Use a different colour for the current Opus generation.
# COLOR_OPUS='\033[38;5;208m'

# Use a different dimmed colour for the legacy Fable generation.
# COLOR_FABLE_LEGACY='\033[38;5;139m'

# ---- Icons ----------------------------------------------------------

# ICON_ACTIVE="►"
# ICON_INACTIVE="◯"

# ---- Happy Mode (easter eggs) ---------------------------------------
# Enable with the helper:  ./happy-mode-tools.sh enable
# Or set the flag directly here:
# HAPPY_MODE="true"

# Tune the chances (in %, decimals allowed). Defaults: 33 / 33 / 10.
# HAPPY_MODE_MATRIX_CHANCE="33"
# HAPPY_MODE_FORTUNE_CHANCE="33"
# HAPPY_MODE_RAINBOW_CHANCE="10"

# Minimum minutes between surprises. Default: 15.
# HAPPY_MODE_COOLDOWN_MINUTES="15"

# Disable time-based triggers (1337, midnight, etc.).
# HAPPY_MODE_TIME_SURPRISES="false"
